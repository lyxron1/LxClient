{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LxClient",
  "version": "2.0.1",
  "identifier": "com.lxclient.launcher",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LxClient",
        "width": 1160,
        "height": 740,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#090a0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/256.png"
    ]
  }
}
